#: Main game title
msgid "Learn Godot!"
msgstr "Lerne Godot!"

#: Button to start the game
msgid "Start Game"
msgstr "Spiel starten"

#: Button to open options menu
msgid "Options"
msgstr "Optionen"

#: Button to exit the game
msgid "Quit"
msgstr "Beenden"

#: Tooltip for start game button
msgid "Start the game"
msgstr "Spiel starten"

#: Tooltip for options button
msgid "Change the options"
msgstr "Optionen ändern"

#: Tooltip for quit button
msgid "Exit the game"
msgstr "Spiel beenden"

#: Tab title for graphics settings
msgid "Graphics"
msgstr "Grafik"

#: Tab title for language settings
msgid "Language"
msgstr "Sprache"

#: Label for resolution dropdown
msgid "Resolution"
msgstr "Auflösung"

#: Label for UI scale setting - scales the entire interface proportionally
msgid "UI Scale"
msgstr "UI-Skalierung"

#: Label for high contrast mode setting - accessibility feature
msgid "High Contrast Mode"
msgstr "Hoher Kontrast Modus"

#: Checkbox text for enabling high contrast theme
msgid "Enable high contrast"
msgstr "Hohen Kontrast aktivieren"

#: Label for window mode dropdown
msgid "Window Mode"
msgstr "Fenstermodus"

#: Window mode option - traditional windowed mode with custom resolution
msgid "Windowed"
msgstr "Fenstermodus"

#: Window mode option - borderless fullscreen at native resolution (recommended)
msgid "Borderless Fullscreen"
msgstr "Randloser Vollbildmodus"

#: Window mode option - exclusive fullscreen mode
msgid "Fullscreen"
msgstr "Vollbild"

#: Resolution option
msgid "1920 x 1080 (Full HD)"
msgstr "1920 x 1080 (Full HD)"

#: Resolution option
msgid "1280 x 720 (HD)"
msgstr "1280 x 720 (HD)"

#: Resolution option
msgid "1600 x 900 (HD+)"
msgstr "1600 x 900 (HD+)"

#: Resolution option
msgid "1366 x 768"
msgstr "1366 x 768"

#: Resolution option
msgid "1024 x 768"
msgstr "1024 x 768"

#: Button to return to menu (short form)
msgid "Back to Menu"
msgstr "Zurück zum Menü"

#: Button to return to main menu (full form)
msgid "Back to main menu"
msgstr "Zurück zum Hauptmenü"

#: Status message when changing resolution. %d placeholders for width and height
msgid "Changing resolution to %dx%d"
msgstr "Auflösung ändern auf %dx%d"

#: Status message when fullscreen is turned on
msgid "Fullscreen enabled"
msgstr "Vollbild aktiviert"

#: Status message when fullscreen is turned off
msgid "Fullscreen disabled"
msgstr "Vollbild deaktiviert"

#: Message shown when starting the game
msgid "Starting the game!"
msgstr "Spiel wird gestartet!"

#: Language name - English
msgid "English"
msgstr "Englisch"

#: Language name - German
msgid "German"
msgstr "Deutsch"

#: Language name - Hungarian
msgid "Hungarian"
msgstr "Ungarisch"

#: Language name - Japanese
msgid "Japanese"
msgstr "Japanisch"
