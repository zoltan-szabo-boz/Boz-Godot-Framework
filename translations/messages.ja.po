#: Main game title
msgid "Learn Godot!"
msgstr "Godotを学ぼう！"

#: Button to start the game
msgid "Start Game"
msgstr "ゲーム開始"

#: Button to open options menu
msgid "Options"
msgstr "オプション"

#: Button to exit the game
msgid "Quit"
msgstr "終了"

#: Tooltip for start game button
msgid "Start the game"
msgstr "ゲームを開始する"

#: Tooltip for options button
msgid "Change the options"
msgstr "オプションを変更する"

#: Tooltip for quit button
msgid "Exit the game"
msgstr "ゲームを終了する"

#: Tab title for graphics settings
msgid "Graphics"
msgstr "グラフィック"

#: Tab title for language settings
msgid "Language"
msgstr "言語"

#: Label for resolution dropdown
msgid "Resolution"
msgstr "解像度"

#: Label for UI scale setting - scales the entire interface proportionally
msgid "UI Scale"
msgstr "UIスケール"

#: Label for window mode dropdown
msgid "Window Mode"
msgstr "ウィンドウモード"

#: Window mode option - traditional windowed mode with custom resolution
msgid "Windowed"
msgstr "ウィンドウ"

#: Window mode option - borderless fullscreen at native resolution (recommended)
msgid "Borderless Fullscreen"
msgstr "ボーダーレスフルスクリーン"

#: Window mode option - exclusive fullscreen mode
msgid "Fullscreen"
msgstr "フルスクリーン"

#: Resolution option
msgid "1920 x 1080 (Full HD)"
msgstr "1920 x 1080 (フルHD)"

#: Resolution option
msgid "1280 x 720 (HD)"
msgstr "1280 x 720 (HD)"

#: Resolution option
msgid "1600 x 900 (HD+)"
msgstr "1600 x 900 (HD+)"

#: Resolution option
msgid "1366 x 768"
msgstr "1366 x 768"

#: Resolution option
msgid "1024 x 768"
msgstr "1024 x 768"

#: Button to return to menu (short form)
msgid "Back to Menu"
msgstr "メニューに戻る"

#: Button to return to main menu (full form)
msgid "Back to main menu"
msgstr "メインメニューに戻る"

#: Status message when changing resolution. %d placeholders for width and height
msgid "Changing resolution to %dx%d"
msgstr "解像度を%dx%dに変更中"

#: Status message when fullscreen is turned on
msgid "Fullscreen enabled"
msgstr "フルスクリーン有効"

#: Status message when fullscreen is turned off
msgid "Fullscreen disabled"
msgstr "フルスクリーン無効"

#: Message shown when starting the game
msgid "Starting the game!"
msgstr "ゲーム開始！"

#: Language name - English
msgid "English"
msgstr "英語"

#: Language name - German
msgid "German"
msgstr "ドイツ語"

#: Language name - Hungarian
msgid "Hungarian"
msgstr "ハンガリー語"

#: Language name - Japanese
msgid "Japanese"
msgstr "日本語"
